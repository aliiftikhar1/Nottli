{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the pet, notes workspace and desktop sticky windows",
  "windows": ["pet", "notes", "sticky-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "sql:default",
    "sql:allow-execute"
  ]
}
